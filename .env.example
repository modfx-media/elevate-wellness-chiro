NEXT_PUBLIC_SITE_URL=https://www.elevatewellnesschiro.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Payload — generate long random values locally. On Vercel, NEXT_PUBLIC_SERVER_URL
# must be the public https origin (never localhost).
PAYLOAD_SECRET=
PREVIEW_SECRET=

# Neon pooled connection (host contains -pooler). Direct 5432 often times out.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=

# Optional production media. Without this, local /media uploads 404 on Vercel.
BLOB_READ_WRITE_TOKEN=
